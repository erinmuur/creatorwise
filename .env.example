# Copy to .env for local development. Never commit .env (it's gitignored).
# Production values live in contextone env vars, not here.
# DATABASE_URL is left unset locally so app.py falls back to ./data/creatorwise.db

# Password gate. Without BOTH of these the app serves nothing but a "locked" page.
# Any throwaway value is fine locally.
DASHBOARD_PASSWORD=local-dev
SECRET_KEY=local-dev-not-a-real-secret

# Fills an EMPTY database with sample data on boot. Set to 0 once real data is in.
SEED_SAMPLE_DATA=1

# Bearer token for /api/ingest, /api/scan and /api/gmail/check.
INGEST_TOKEN=local-dev-token

# Gmail scanner — leave unset locally. See docs/gmail-setup.md.
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
# GMAIL_REFRESH_TOKEN=

# tools/push_data.py: copies data/ to the deployed site. SYNC_TOKEN is the same
# value as the contextone env var; SYNC_URL is the site's https address.
# SYNC_TOKEN=
# SYNC_URL=
